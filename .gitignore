outputs/_repro_a/
outputs/_repro_b/

# Large row-level artefacts. The summary artefacts the README reads from ARE
# committed, so the repository renders correctly without a pipeline run; the
# per-alert detail behind them is regenerated on demand.
outputs/screening_alerts.csv
outputs/rule_alerts.csv
outputs/audit_log.jsonl
outputs/pipeline.log
